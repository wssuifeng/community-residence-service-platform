<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan testclass="TestPlan" guiclass="TestPlanGui" testname="dc最新非交易七接口压测" enabled="true" />
    <hashTree>
      <SetupThreadGroup testclass="SetupThreadGroup" guiclass="SetupThreadGroupGui" testname="200账号实际登录" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">200</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <CSVDataSet testclass="CSVDataSet" guiclass="TestBeanGUI" testname="本批隔离账号池" enabled="true">
          <stringProp name="filename">D:/code/community-residence-service-platform/output/runtime/dc-closeout/accounts.csv</stringProp>
          <stringProp name="variableNames">username,password,wid</stringProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
        </CSVDataSet>
        <hashTree />
        <HeaderManager testclass="HeaderManager" guiclass="HeaderPanel" testname="请求头" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Content-Type" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <HTTPSamplerProxy testclass="HTTPSamplerProxy" guiclass="HttpTestSampleGui" testname="setup-login" enabled="true">
          <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
          <stringProp name="HTTPSampler.port">8087</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/auth/resident/login</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"username":"${username}","password":"${password}"}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion testclass="ResponseAssertion" guiclass="AssertionGui" testname="HTTP 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="200">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree />
          <JSONPathAssertion testclass="JSONPathAssertion" guiclass="JSONPathAssertionGui" testname="business code 200" enabled="true">
            <stringProp name="JSON_PATH">$.code</stringProp>
            <stringProp name="EXPECTED_VALUE">200</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
          </JSONPathAssertion>
          <hashTree />
          <JSONPostProcessor testclass="JSONPostProcessor" guiclass="JSONPostProcessorGui" testname="extract token" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">token</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.token</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.default_values">TOKEN_NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree />
          <JSR223PostProcessor testclass="JSR223PostProcessor" guiclass="TestBeanGUI" testname="write private tokens" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">assert vars.get('token') != 'TOKEN_NOT_FOUND'; new File('D:/code/community-residence-service-platform/output/runtime/dc-closeout/tokens-base.csv').append(vars.get('username')+','+vars.get('token')+','+vars.get('wid')+System.lineSeparator())</stringProp>
          </JSR223PostProcessor>
          <hashTree />
        </hashTree>
      </hashTree>
      <ThreadGroup testclass="ThreadGroup" guiclass="ThreadGroupGui" testname="50 HTTP users" enabled="true">
        <intProp name="ThreadGroup.num_threads">50</intProp>
        <intProp name="ThreadGroup.ramp_time">60</intProp>
        <stringProp name="ThreadGroup.duration">660</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">-1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet testclass="CSVDataSet" guiclass="TestBeanGUI" testname="本批隔离账号池" enabled="true">
          <stringProp name="filename">D:/code/community-residence-service-platform/output/runtime/dc-closeout/tokens-base.csv</stringProp>
          <stringProp name="variableNames">tuser,token,wid</stringProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
        </CSVDataSet>
        <hashTree />
        <HeaderManager testclass="HeaderManager" guiclass="HeaderPanel" testname="请求头" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="Authorization" elementType="Header">
              <stringProp name="Header.name">Authorization</stringProp>
              <stringProp name="Header.value">Bearer ${token}</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <ConstantTimer testclass="ConstantTimer" guiclass="ConstantTimerGui" testname="500ms pacing" enabled="true">
          <stringProp name="ConstantTimer.delay">500</stringProp>
        </ConstantTimer>
        <hashTree />
        <HTTPSamplerProxy testclass="HTTPSamplerProxy" guiclass="HttpTestSampleGui" testname="L1-communities" enabled="true">
          <stringProp name="HTTPSampler.domain">127.0.0.1</stringProp>
          <stringProp name="HTTPSampler.port">8087</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/communities?page=1&amp;size=20</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
