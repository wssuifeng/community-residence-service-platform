    { "id": "agg-resident", "from": "backend", "to": "db", "y": 336, "label": "聚合查询：居民与入住/搬出量" },
    { "id": "agg-workorder", "from": "backend", "to": "db", "y": 380, "label": "聚合查询：工单量/完成率/处理时长" },
    { "id": "agg-staff", "from": "backend", "to": "db", "y": 424, "label": "聚合查询：服务人员工作量" },
    { "id": "agg-evaluation", "from": "backend", "to": "db", "y": 468, "label": "聚合查询：满意度统计" },
    { "id": "agg-reservation", "from": "backend", "to": "db", "y": 512, "label": "聚合查询：公共资源预约量" },
    { "id": "read-views", "from": "backend", "to": "redis", "y": 556, "label": "查询浏览统计", "note": "房源浏览量与带看量（R57）" },
    { "id": "cache-write", "from": "backend", "to": "redis", "y": 600, "label": "写入缓存（TTL）", "variant": "dashed" },
