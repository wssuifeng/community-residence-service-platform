    { "id": "select-detail", "from": "backend", "to": "db", "y": 746, "label": "SELECT 明细记录" },
    { "id": "return-detail", "from": "backend", "to": "admin", "y": 790, "label": "返回明细数据", "variant": "return" },
    { "id": "verify", "from": "backend", "to": "admin", "y": 848, "label": "核对：统计值与明细100%相符", "note": "管理员核对（答辩演示口径，R41）", "variant": "return" }
