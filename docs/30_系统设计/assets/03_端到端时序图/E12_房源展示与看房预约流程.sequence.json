{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "E12：房源展示与看房预约流程",
    "locale": "zh-CN",
    "output": "E12_房源展示与看房预约流程时序图.html",
    "quality_profile": "showcase",
    "viewBox": [920, 560]
  },
  "participants": [
    { "id": "admin", "type": "external", "label": "小区管理员", "sublabel": "上架/登记" },
    { "id": "public-access", "type": "external", "label": "公开访问", "sublabel": "未登录浏览房源与时段" },
    { "id": "resident", "type": "external", "label": "居民账号", "sublabel": "登录后预约看房" },
    { "id": "backend", "type": "backend", "label": "后端服务", "sublabel": "REST API" },
    { "id": "db", "type": "database", "label": "MySQL", "sublabel": "业务库" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "浏览计数" },
    { "id": "notify", "type": "messagebus", "label": "通知服务", "sublabel": "站内推送" }
  ],
  "messages": [
    { "id": "create-housing", "from": "admin", "to": "backend", "y": 160, "label": "POST /api/v1/housings", "note": "真实信息自查后上架（R52）", "variant": "emphasis" },
    { "id": "insert-housing", "from": "backend", "to": "db", "y": 188, "label": "校验并写入 AVAILABLE 房源" },
    { "id": "create-timeslot", "from": "admin", "to": "backend", "y": 216, "label": "POST /api/v1/housings/{id}/timeslots", "note": "配置并保存可预约时段" },
    { "id": "browse", "from": "public-access", "to": "backend", "y": 244, "label": "查询房源列表、详情与时段", "note": "未登录公开浏览（R53）；可预约时段只读" },
    { "id": "select-public-data", "from": "backend", "to": "db", "y": 272, "label": "读取可见房源与预约时段" },
    { "id": "incr-view", "from": "backend", "to": "redis", "y": 300, "label": "INCR housing:{id}:view_count", "note": "详情浏览量（R57）" },
    { "id": "book", "from": "resident", "to": "backend", "y": 328, "label": "POST /api/v1/viewing-appointments", "note": "仅已登录居民账号可申请", "variant": "emphasis" },
    { "id": "validate-create", "from": "backend", "to": "db", "y": 356, "label": "校验时段/冲突并写入 TO_CONFIRM", "note": "R54 时段校验 + R33 重叠拦截" },
    { "id": "notify-new", "from": "backend", "to": "notify", "y": 384, "label": "推送新预约给对应小区管理员" },
    { "id": "confirm", "from": "admin", "to": "backend", "y": 412, "label": "PATCH /api/v1/viewing-appointments/{id}/confirm", "note": "TO_CONFIRM → RESERVED；提交后通知居民" },
    { "id": "update-reserved", "from": "backend", "to": "db", "y": 440, "label": "UPDATE status=RESERVED", "note": "预约确认提交后通知居民" },
    { "id": "complete-or-violate", "from": "admin", "to": "backend", "y": 468, "label": "PATCH /api/v1/viewing-appointments/{id}/complete | /violate", "note": "指定服务人员可登记完成；管理员处理违约（R56）。完成后记带看量（R57）" }
  ]
}
