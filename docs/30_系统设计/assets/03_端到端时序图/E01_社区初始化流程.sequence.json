    { "id": "create-building", "from": "admin", "to": "backend", "y": 380, "label": "POST /api/v1/buildings", "note": "创建楼栋" },
    { "id": "insert-building", "from": "backend", "to": "db", "y": 424, "label": "INSERT tb_building" },
