    { "id": "insert-resource", "from": "backend", "to": "db", "y": 994, "label": "INSERT tb_public_resource" },
    { "id": "create-timeslot", "from": "admin", "to": "backend", "y": 1038, "label": "POST /api/v1/resources/{id}/timeslots", "note": "配置可预约时段" },
    { "id": "insert-timeslot", "from": "backend", "to": "db", "y": 1082, "label": "INSERT tb_resource_timeslot" },
    { "id": "done", "from": "backend", "to": "admin", "y": 1126, "label": "社区初始化完成", "variant": "return" }
