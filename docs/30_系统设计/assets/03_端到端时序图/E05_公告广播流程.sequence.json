    { "id": "publish", "from": "admin", "to": "backend", "y": 336, "label": "PATCH /api/v1/notices/{id}/publish", "note": "发布 → PUBLISHED" },
    { "id": "update-published", "from": "backend", "to": "db", "y": 380, "label": "UPDATE status=PUBLISHED" },
    { "id": "notify-send", "from": "backend", "to": "notify", "y": 424, "label": "生成站内通知（R48）", "note": "触达目标范围用户" },
