    { "id": "return-notice", "from": "backend", "to": "user", "y": 672, "label": "返回公告内容", "variant": "return" },
    { "id": "scan", "from": "scheduler", "to": "db", "y": 730, "label": "扫描 tb_notice", "note": "定时任务：检查 valid_until < NOW()" },
    { "id": "archive", "from": "scheduler", "to": "db", "y": 774, "label": "UPDATE status=ARCHIVED", "note": "过期公告自动下线（R26）" }
