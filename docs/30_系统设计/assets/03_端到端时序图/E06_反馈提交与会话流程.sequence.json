  "cards": [
    {
      "dot": "emerald",
      "title": "反馈主线",
      "items": [
        "提交反馈 → 受理 → 长连接会话沟通 → 办结归档",
        "触发：居民提交投诉/意见/建议"
      ]
    },
    {
      "dot": "violet",
      "title": "会话式沟通（R30）",
      "items": [
        "长连接双向实时沟通，响应 ≤3 秒",
