{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "公共资源预约状态机（C7）",
    "locale": "zh-CN",
    "output": "03_公共资源预约状态机图.html",
    "quality_profile": "showcase",
    "viewBox": [980, 720]
  },
  "lanes": [
    { "id": "main", "label": "主流程" },
    { "id": "terminal", "label": "终态" }
  ],
  "states": [
    { "id": "PENDING", "type": "start", "label": "待审核", "sublabel": "居民提交预约", "lane": "main", "col": 0, "step": "01" },
    { "id": "CONFIRMED", "type": "active", "label": "已预约", "sublabel": "审核通过", "lane": "main", "col": 1, "step": "02" },
    { "id": "COMPLETED", "type": "success", "label": "已完成", "sublabel": "到期登记", "lane": "main", "col": 2, "step": "03", "tag": "终态" },
    { "id": "REJECTED", "type": "failure", "label": "已拒绝", "sublabel": "审核拒绝（附理由）", "lane": "terminal", "col": 0, "tag": "终态" },
    { "id": "CANCELED", "type": "failure", "label": "已取消", "sublabel": "用户取消", "lane": "terminal", "col": 1, "tag": "终态" },
    { "id": "VIOLATED", "type": "failure", "label": "已违约", "sublabel": "处置：冻结/限制（R35）", "lane": "terminal", "col": 2, "tag": "终态" }
  ],
  "transitions": [
    { "id": "approve", "from": "PENDING", "to": "CONFIRMED", "label": "审核通过", "labelAt": [171, 202] },
    { "id": "register", "from": "CONFIRMED", "to": "COMPLETED", "label": "到期登记", "labelAt": [325, 202] },
    { "id": "reject", "from": "PENDING", "to": "REJECTED", "label": "审核拒绝（理由）", "variant": "security", "fromSide": "bottom", "toSide": "left" },
    { "id": "cancel", "from": "CONFIRMED", "to": "CANCELED", "label": "用户取消", "variant": "security", "fromSide": "bottom", "toSide": "top" },
    { "id": "violate", "from": "CONFIRMED", "to": "VIOLATED", "label": "违约登记", "variant": "security", "fromSide": "bottom", "toSide": "top" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "主流程",
      "items": [
        "待审核 → 已预约 → 已完成，预约到使用完整闭环"
      ]
    },
    {
      "dot": "rose",
      "title": "终态与违约处置",
      "items": [
        "已拒绝 / 已取消 / 已违约 / 已完成均为终态",
        "违约登记后处置：冻结账号 / 限制预约，处置留痕（R35）"
      ]
    },
    {
      "dot": "amber",
      "title": "时段约束",
      "items": [
        "时段外提交：提交即拒绝，不入状态机（R32）",
        "冲突校验：同一资源同一时段重叠 100% 拦截（R33）"
      ]
    }
  ]
}
