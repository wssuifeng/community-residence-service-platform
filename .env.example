# =============================================================================
# 本地运行凭据模板（复制为 .env 后填值；.env 已被 .gitignore 忽略，禁止入库）
# =============================================================================
# 用法：
#   cp .env.example .env       # 然后按下面注释逐项填值
#   启动：cd backend && ./mvnw spring-boot:run   —— 无需手工 export
#
# 机制：backend/src/main/resources/application.yml 里通过
#   spring.config.import: optional:file:./.env[.properties]
#                       optional:file:../.env[.properties]
# 把本文件当作「properties 语法的配置文件」读入 Spring Environment
# （.env 的 KEY=VALUE 写法与 properties 兼容，故不需要额外依赖）。
#   优先级：命令行参数 / 系统环境变量 高于本文件 —— 本文件的职责是给
#   application*.yml 里的 ${...} 占位符供值；真的环境变量仍可覆盖同名键，
#   CI/生产用环境变量注入即可。
#   路径：`./.env` 相对「启动进程的工作目录」，故同时导入 `../.env`
#   以覆盖「在 backend/ 下跑 mvnw」与「在仓库根目录跑」两种情形。
# =============================================================================

# --- MySQL（必需；对应 application-dev.yml 的 ${DB_USERNAME:root} / ${DB_PASSWORD}）---
DB_USERNAME=root
DB_PASSWORD=

# --- JWT 签名密钥（必需；≥32 字符。未设置时 dev 用仅限本机的默认值，生产必须设置）---
# 生成：openssl rand -base64 32  或
#       -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=

# --- Redis（可选；默认 localhost:6379 无密码，Memurai/Redis 有密码时才需要）---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- 数据库连接覆盖（可选）---
# 默认走 application-dev.yml 的 community_residence；要指向 50 阶段独立测试库时，
# 两种方式二选一（推荐命令行环境变量，避免污染默认开发环境）：
#   1) 环境变量：$env:SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/community_residence_test?..."
#   2) 取消下面注释（此后默认就指向测试库）
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/community_residence_test?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# --- 支付宝（可选；R61 租约续约支付。四项齐全才启用渠道，缺一则渠道禁用并明示）---
# 沙箱：https://open.alipay.com 控制台「沙箱环境」；密钥工具生成 RSA2 应用私钥/公钥
PAYMENT_ALIPAY_APP_ID=
PAYMENT_ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
PAYMENT_ALIPAY_MERCHANT_PRIVATE_KEY=
PAYMENT_ALIPAY_PUBLIC_KEY=
# 支付完成后前端回跳地址（可选）
# PAYMENT_ALIPAY_RETURN_URL=

# --- 微信支付（可选；Native 扫码，需商户资质、无公开沙箱，本地一般留空）---
# PAYMENT_WECHAT_MCH_ID=
# PAYMENT_WECHAT_APP_ID=
# PAYMENT_WECHAT_API_V3_KEY=
# PAYMENT_WECHAT_MERCHANT_SERIAL_NO=
# PAYMENT_WECHAT_PRIVATE_KEY=
# PAYMENT_WECHAT_PRIVATE_KEY_PATH=
