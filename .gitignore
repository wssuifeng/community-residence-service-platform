# 依赖与构建产物
node_modules/
dist/
target/

# 日志与临时文件
*.log
*.tmp

# 上传文件运行时目录（FileUploadService 本地存储，不入库）
backend/uploads/

# IDE
.idea/
*.iml

# 编辑器/代理工具本地配置（.zcodeignore 为 .gitignore 的镜像副本，
# 由工具同步生成，事实来源是 .gitignore 本身）
.zcodeignore

# 系统文件
.DS_Store
Thumbs.db

# 项目文档：正文、设计素材与测试证据均入库
# （2026-09-21 用户裁决放开整目录忽略，取代原「暂不上传，本地保留」口径；
#   此前只能逐文件 git add -f，漏加会静默丢失）
# 仅排除生成型大体积产物与工具临时目录，见下。
# 注：以下规则只拦**新增**文件。`nf_steady_r2.jtl.gz` / `nf_steady_r5.jtl`
# 两份虽命中 `*.jtl*` 但已被跟踪——它们是 02_需求跟踪矩阵 N1 与
# 07_测试执行记录引用的**正式性能证据**（合计 11 MB），有意保留入库。
docs/**/*.jtl
docs/**/*.jtl.gz
docs/**/jmeter.log
docs/**/__pycache__/
docs/**/*.pyc
docs/**/.archify-delivery-*/

# 第三方资料（学校文件 / 维普操作手册 / 论文格式模版 / 他人样例开题报告 /
# 他人论文撰写指导）：仓库为公开仓库，入库等于再发布他人版权资料，
# 故不入库（仅本地保留）
docs/90_全局/参考资料/
docs/archive/参考资料归档-*/

# 验收截图回归产物（沿用 2026-09-16「回归本地不入库」口径）
frontend/acceptance-shots/
