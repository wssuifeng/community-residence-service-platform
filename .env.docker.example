# Copy to .env.docker. This file is for Docker Compose only and is not committed.
COMPOSE_PROJECT_NAME=community-residence-local

MYSQL_DATABASE=community_residence
MYSQL_APP_USER=community
MYSQL_APP_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# At least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=change-this-jwt-secret-to-at-least-32-characters

MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=8088
APP_LOG_LEVEL=INFO
