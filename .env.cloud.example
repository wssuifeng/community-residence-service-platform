# 云端 Compose 示例配置。复制为部署机上的 .env.cloud，不要提交真实值。
COMPOSE_PROJECT_NAME=community-residence

# 指向已推送到镜像仓库的固定版本，不要在云端使用 :latest。
BACKEND_IMAGE=crpi-1trewaz90eq5799a.cn-hongkong.personal.cr.aliyuncs.com/community-residence/backend:cloud-20261021-r1
FRONTEND_IMAGE=crpi-1trewaz90eq5799a.cn-hongkong.personal.cr.aliyuncs.com/community-residence/frontend:cloud-20261021-r1

MYSQL_DATABASE=community_residence
MYSQL_APP_USER=community
MYSQL_APP_PASSWORD=replace-with-a-generated-secret
MYSQL_ROOT_PASSWORD=replace-with-a-different-generated-secret
JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_PASSWORD=replace-with-a-generated-redis-secret

# TLS reverse proxy forwards to this loopback port; do not expose it publicly.
FRONTEND_HOST_PORT=8088

# 云端 Compose 不发布数据库、Redis和后端端口；前端入口由反向代理或负载均衡接入。
APP_LOG_LEVEL=INFO
